# Copy to .env.local. Empty placeholders intentionally keep setup closed.
# Only the service URL and modern publishable key may be exposed to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The one canonical origin this deployment answers on: scheme and host only,
# HTTPS (for example https://app.example.test), or an http loopback such as
# http://localhost:3000 while developing. No credentials, path, query or
# fragment, and no wildcard or per-deployment host. Server-only; sign-in and
# every authenticated route stay closed until it is set.
APP_ORIGIN=

# Required for private media processing and signing, and for private audio.
# Never use a NEXT_PUBLIC_ prefix and never expose it to a browser. Scope it to
# Production only; Preview and Development must not hold it.
SUPABASE_SECRET_KEY=
