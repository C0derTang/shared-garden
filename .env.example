# Copy to .env.local. Empty placeholders intentionally keep setup closed.
# Only the service URL and modern publishable key may be exposed to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional for later privileged server work. Never use a NEXT_PUBLIC_ prefix.
# Not needed to run the public landing or its tests.
SUPABASE_SECRET_KEY=
